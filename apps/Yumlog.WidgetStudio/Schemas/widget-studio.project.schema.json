{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.github.io/yumlog/widget-studio.project.schema.json",
  "title": "Yumlog Widget Studio Project",
  "type": "object",
  "required": ["schemaVersion", "projectId", "name", "version", "widget", "package"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "1.0 is the baseline contract. 1.1 adds widget capability contracts and vendor extension bags.",
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "projectId": {
      "$ref": "#/$defs/semanticId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "widget": {
      "$ref": "#/$defs/widget"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "handoffNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensionBag"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "not": {
          "required": ["extensions"]
        },
        "properties": {
          "widget": {
            "not": {
              "required": ["capabilities"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "extensionBag": {
      "description": "Namespaced vendor extension bag. Requires schemaVersion 1.1 or later.",
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z0-9]+([.-][a-z0-9]+)*$"
      },
      "additionalProperties": true
    },
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "schemaUri": {
      "type": "string",
      "minLength": 1
    },
    "widget": {
      "type": "object",
      "required": ["id", "displayName", "description", "kind", "dataSources", "acpActions", "apimBindings", "render", "refreshCadence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Core widget models. Vendor models must use an 'x-' prefix.",
          "anyOf": [
            {
              "type": "string",
              "enum": ["adaptiveLiveTile", "paperboyLiveTile", "dashboardTile", "agentCardTile"]
            },
            {
              "type": "string",
              "pattern": "^x-[a-zA-Z0-9]+([.-][a-zA-Z0-9]+)*$"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataSource"
          }
        },
        "acpActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acpAction"
          }
        },
        "apimBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/apimBinding"
          }
        },
        "capabilities": {
          "description": "Versioned capability contracts. Requires schemaVersion 1.1 or later.",
          "type": "array",
          "items": {
            "$ref": "https://darbotlabs.github.io/yumlog/widget-studio.capability.schema.json"
          }
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "refreshCadence": {
          "$ref": "#/$defs/refreshCadence"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["id", "type", "displayName", "payloadSchemaUri"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["apimOperation", "acpEnvelope", "staticJson", "mdkgLayer"]
            },
            {
              "type": "string",
              "pattern": "^x-[a-zA-Z0-9]+([.-][a-zA-Z0-9]+)*$"
            }
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "bindingRef": {
          "type": "string"
        },
        "payloadSchemaUri": {
          "$ref": "#/$defs/schemaUri"
        },
        "refreshPolicy": {
          "type": "string",
          "enum": ["inherit", "manual", "interval", "eventDriven"]
        },
        "samplePayload": true
      }
    },
    "acpAction": {
      "type": "object",
      "required": ["id", "displayName", "capability", "envelopeSchemaUri", "permission"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "envelopeSchemaUri": {
          "$ref": "#/$defs/schemaUri"
        },
        "inputSchemaUri": {
          "type": "string"
        },
        "outputSchemaUri": {
          "type": "string"
        },
        "permission": {
          "type": "string",
          "enum": ["read", "invoke", "write", "admin"]
        },
        "targetDataSourceId": {
          "type": "string"
        }
      }
    },
    "apimBinding": {
      "type": "object",
      "required": ["id", "backendId", "operationId", "method", "route", "responseSchemaUri"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "backendId": {
          "$ref": "#/$defs/semanticId"
        },
        "operationId": {
          "$ref": "#/$defs/semanticId"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "baseUrl": {
          "type": "string"
        },
        "authScheme": {
          "type": "string"
        },
        "requestSchemaUri": {
          "type": "string"
        },
        "responseSchemaUri": {
          "$ref": "#/$defs/schemaUri"
        },
        "policyTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["schemaUri", "layout", "states", "bindings"],
      "additionalProperties": false,
      "properties": {
        "schemaUri": {
          "$ref": "#/$defs/schemaUri"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["card", "grid", "hero", "list", "stack"]
            },
            {
              "type": "string",
              "pattern": "^x-[a-zA-Z0-9]+([.-][a-zA-Z0-9]+)*$"
            }
          ]
        },
        "theme": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/renderState"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/renderBinding"
          }
        }
      }
    },
    "renderState": {
      "type": "object",
      "required": ["id", "title", "intent"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "visibleWhen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "renderBinding": {
      "type": "object",
      "required": ["id", "sourceId", "fieldPath", "target", "format"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "sourceId": {
          "$ref": "#/$defs/semanticId"
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["text", "badge", "number", "datetime", "json", "status"]
        }
      }
    },
    "refreshCadence": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "interval", "cron", "eventDriven"]
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "jitterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "staleAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "cron": {
          "type": "string"
        },
        "eventTopic": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "required": ["packageId", "format", "includePreview", "includeSchemas"],
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "const": "yumlog.widget.v1+zip"
        },
        "includePreview": {
          "type": "boolean"
        },
        "includeSchemas": {
          "type": "boolean"
        },
        "includeCapabilityIndex": {
          "type": "boolean"
        }
      }
    }
  }
}
