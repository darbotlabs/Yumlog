    "inputs": ["modelAlias", "modelRole", "endpoint", "deliveryProfile", "device"],
    "outputs": ["modelCardJson", "recommendedBundle", "mcpToolHints", "cacheState"],
    "actions": ["showModels", "downloadModel", "loadModel", "modelInfo", "exportModelCards", "bundleModelCards", "deliverModel"],
    "liveTileState": "catalog|selected|bundled|delivered"
  },
  {
    "id": "paperboy.apim",
    "title": "APIM Surface",
    "role": "apim-control-plane",
